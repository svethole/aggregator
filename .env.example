# ─── Aggregator – Konfiguration ──────────────────────────────────────────────
# Kopiere diese Datei nach ".env" und passe die Werte an.

# Öffentliche Adresse (wichtig für sichere Cookies über HTTPS)
BASE_URL=https://aggregator.svetho.net

# Port, auf dem die App lauscht (hinter Nginx/Caddy reicht localhost)
PORT=3000
HOST=127.0.0.1

# Erster Benutzer wird beim ersten Start automatisch angelegt.
# Danach kannst Du ADMIN_PASSWORD wieder entfernen.
ADMIN_USER=sven
ADMIN_PASSWORD=bitte-ein-langes-passwort-waehlen

# Wie oft die Quellen abgerufen werden (Minuten)
REFRESH_INTERVAL_MINUTES=30

# Wie lange Artikel aufbewahrt werden (Tage). Favoriten und Verlauf bleiben immer erhalten.
ARTICLE_RETENTION_DAYS=90

# Quellensuche: API-Schlüssel von https://brave.com/search/api/ (optional).
# Ohne Schlüssel wird DuckDuckGo als Notlösung verwendet (SEARCH_FALLBACK=false schaltet das ab).
BRAVE_API_KEY=
SEARCH_FALLBACK=true

# Speicherort der Datenbank
DATA_DIR=./data
