# ─── Aggregator – Konfiguration ──────────────────────────────────────────────
# Kopiere diese Datei nach ".env" und passe die Werte an.

# Öffentliche Adresse (wichtig für sichere Cookies über HTTPS)
BASE_URL=https://aggregator.svetho.net

# Port, auf dem die App lauscht – nur lokal, nach außen geht's über nginx
PORT=3070
HOST=127.0.0.1

# Benutzer, der beim ersten Start automatisch angelegt wird
ADMIN_USER=sven

# Gemeinsame svetho-Anmeldung: nginx meldet über diesen Header, ob das Cookie gültig ist.
# Dann ist keine zweite Anmeldung in der App nötig. Leer lassen = eigene Anmeldung der App.
PROXY_AUTH_HEADER=X-Svetho-Sso
LOGOUT_URL=https://svetho.net/abmelden

# Nur nötig ohne gemeinsame Anmeldung: Passwort für ADMIN_USER (danach wieder entfernen)
ADMIN_PASSWORD=

# Wie oft die Quellen abgerufen werden (Minuten)
REFRESH_INTERVAL_MINUTES=30

# Wie lange Artikel aufbewahrt werden (Tage). Favoriten und Verlauf bleiben immer erhalten.
ARTICLE_RETENTION_DAYS=90

# Quellensuche: API-Schlüssel von https://brave.com/search/api/ (optional).
# Ohne Schlüssel wird DuckDuckGo als Notlösung verwendet (SEARCH_FALLBACK=false schaltet das ab).
BRAVE_API_KEY=
SEARCH_FALLBACK=true

# Speicherort der Datenbank (außerhalb des Repos)
DATA_DIR=/var/lib/aggregator
